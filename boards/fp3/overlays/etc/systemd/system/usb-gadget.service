[Unit]
Description=USB gadget (NCM network) setup
After=local-fs.target
Before=network-pre.target isc-dhcp-server.service citronics-net-id.service
DefaultDependencies=no
Wants=network-pre.target

[Service]
Type=oneshot
# Not RemainAfterExit: udev starts it again when a UDC appears later
RemainAfterExit=no
ExecStart=/usr/libexec/usb-gadget-setup

[Install]
WantedBy=multi-user.target
